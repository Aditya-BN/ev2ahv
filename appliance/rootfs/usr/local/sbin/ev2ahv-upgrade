#!/usr/bin/python3
"""ev2ahv appliance upgrade (D7). Run as root on the appliance.

  ev2ahv-upgrade status
  ev2ahv-upgrade apply  /path/ev2ahv-upgrade-<ver>.tar.gz [--force]   verify, back up, install, start, health check
  ev2ahv-upgrade rollback                                               back to the previous app, venv and database
  ev2ahv-upgrade prune --keep N [--dry-run]                             delete all but the newest N backups (N >= 1)
  ev2ahv-upgrade apply-request                                          apply a bundle the web UI uploaded (run by
                                                                        ev2ahv-upgrade.path/.service, as root)

Signatures: a bundle may carry manifest.json.sig (Ed25519 over manifest.json, tools/make_bundle.py --sign). If any
public key is installed in /etc/ev2ahv/upgrade-keys/*.pub, apply requires a signature that verifies against one of
them (openssl pkeyutl); with no keys installed, unsigned bundles are accepted as before.

apply refuses a bundle whose files do not match its manifest, a downgrade (unless --force) and an upgrade while a
migration step is running. Before it touches anything it stops the app and saves the app, the venv (when the
requirements change), the state directory (database, engine plans and chunk records) and /etc/ev2ahv/ev2ahv.env under /var/lib/ev2ahv/backups/<time>-<old version>/. If the new version does not answer
its health check, it restores all of that and starts the old version again. Stdlib only.
"""
import argparse, hashlib, json, os, re, shutil, subprocess, sys, tarfile, tempfile, time

P = {  # paths; tests point them at a temporary tree
    "app": "/opt/ev2ahv/app", "venv": "/opt/ev2ahv/venv", "data": "/var/lib/ev2ahv",
    "state": "/var/lib/ev2ahv/.local/share/ev2ahv", "env": "/etc/ev2ahv/ev2ahv.env",
    "sock": "/run/ev2ahv/app.sock", "self": "/usr/local/sbin/ev2ahv-upgrade",
    "link": "/usr/sbin/ev2ahv-upgrade",             # in sudo's secure_path, so `sudo ev2ahv-upgrade` works
    "cookie": "/run/ev2ahv/health.cookie",          # read-only session the app writes at start (0.3.3+)
    "keys": "/etc/ev2ahv/upgrade-keys",             # trusted signing keys (*.pub); none installed = unsigned allowed
    "spool": "/var/lib/ev2ahv/upgrade",             # the web UI drops bundle.tar.gz + request.json here
    "units": "/usr/lib/systemd/system",
}
# read endpoints that load stored data through the data model; all must answer 200 after an upgrade (D7)
HEALTH_PATHS = ("/api/v2/plans", "/api/v2/plans/vms", "/api/v2/providers", "/api/v2/events", "/api/v2/settings")
HEALTH_DATA_FROM = (0, 3, 3)   # first version that writes the health cookie
SERVICE = "ev2ahv"


class UpgradeError(RuntimeError):
    pass


def _managed(path):
    """True only for a path this tool owns: one of the P[...] trees (or the venv's .new twin), or something
    strictly inside the data directory (backups, scratch dirs). Never a symlink, never "/" or a top-level dir."""
    ap = os.path.abspath(path)
    if ap != os.path.normpath(path) or os.path.islink(ap) or ap.count(os.sep) < 2:
        return False
    base = {os.path.abspath(P[k]) for k in ("app", "venv", "state")}
    own = base | {b + ".new" for b in base} | {b + ".restore" for b in base}
    if ap in own:
        return True
    data = os.path.realpath(P["data"])
    return os.path.realpath(ap).startswith(data + os.sep)


def rm_tree(path):
    """shutil.rmtree for the trees this tool manages; refuses anything else (empty, "/", $HOME, a symlink, ...)."""
    if not path or not _managed(path):
        raise UpgradeError(f"refusing to delete {path!r}: not a directory managed by ev2ahv-upgrade")
    shutil.rmtree(path, ignore_errors=True)


def replace_tree(src, dst):
    """Make dst a copy of src. The copy is built beside dst first, so a bad or missing src never deletes dst."""
    if not os.path.isdir(src):
        raise UpgradeError(f"backup {src} is missing: leaving {dst} untouched")
    tmp = dst + ".restore"
    rm_tree(tmp)
    shutil.copytree(src, tmp, symlinks=True)
    rm_tree(dst)
    os.rename(tmp, dst)


def log(msg):
    print(time.strftime("%H:%M:%S"), msg, flush=True)


def sh(*argv, check=True):
    return subprocess.run(argv, check=check, capture_output=True, text=True)


def vtuple(v):
    return tuple(int(x) for x in v.strip().split(".")[:3])


def current_version():
    try:
        with open(os.path.join(P["app"], "VERSION")) as fh:
            return fh.read().strip()
    except OSError:
        return "0.0.0"


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for b in iter(lambda: fh.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def unpack(bundle, into):
    with tarfile.open(bundle) as tf:
        for m in tf.getmembers():
            if m.name.startswith("/") or ".." in m.name.split("/") or not (m.isfile() or m.isdir()):
                raise UpgradeError(f"unsafe member in bundle: {m.name}")
        # The member checks above always run. Where the tarfile module has extraction filters (3.12+ and the security
        # backports in 3.9 and later) also use filter="data", which refuses links and paths outside `into` and keeps
        # the 3.12 DeprecationWarning (and its 3.14 default change) away; older Pythons have no filter to pass.
        if hasattr(tarfile, "data_filter"):
            tf.extractall(into, filter="data")
        else:
            tf.extractall(into)
    man_path = os.path.join(into, "manifest.json")
    if not os.path.exists(man_path):
        raise UpgradeError("bundle has no manifest.json")
    verify_signature(man_path, man_path + ".sig")
    with open(man_path) as fh:
        man = json.load(fh)
    for rel, digest in man["files"].items():
        if rel.startswith("/") or ".." in rel.split("/"):
            raise UpgradeError(f"unsafe path in the manifest: {rel}")
        f = os.path.join(into, rel)
        if not os.path.isfile(f) or sha256(f) != digest:
            raise UpgradeError(f"bundle file {rel} is missing or does not match the manifest")
    extra = {os.path.relpath(os.path.join(d, n), into) for d, _, ns in os.walk(into) for n in ns} - set(man["files"]) \
        - {"manifest.json", "manifest.json.sig"}
    if extra:
        raise UpgradeError(f"bundle has files not in the manifest: {sorted(extra)[:5]}")
    return man


def trusted_keys():
    d = P["keys"]
    return sorted(os.path.join(d, n) for n in os.listdir(d) if n.endswith(".pub")) if os.path.isdir(d) else []


def verify_signature(manifest, sig):
    """Require a valid Ed25519 signature over manifest.json when trusted keys are installed (D7)."""
    keys = trusted_keys()
    if not keys:
        if os.path.exists(sig):
            log("bundle is signed, but no trusted keys are installed in " + P["keys"] + ": signature not checked")
        return None
    if not os.path.exists(sig):
        raise UpgradeError(f"bundle is not signed, and {P['keys']} holds trusted keys: refusing it")
    for k in keys:
        r = sh("openssl", "pkeyutl", "-verify", "-pubin", "-inkey", k, "-rawin", "-in", manifest, "-sigfile", sig,
               check=False)
        if r.returncode == 0:
            log(f"signature verified with {os.path.basename(k)}")
            return k
    raise UpgradeError("bundle signature does not verify against any trusted key")


def install_units(work):
    """Install the systemd units a bundle carries (systemd/*), so UI upgrades reach older appliances too."""
    src = os.path.join(work, "systemd")
    if not os.path.isdir(src):
        return []
    names = sorted(n for n in os.listdir(src) if re.match(r"^ev2ahv-[\w.@-]+\.(service|path|timer)$", n))
    for n in names:
        shutil.copy2(os.path.join(src, n), os.path.join(P["units"], n))
    if names and not os.path.isdir(P["spool"]):   # appliances built before 0.3.7 have no spool yet
        os.makedirs(P["spool"], mode=0o770)
        try:
            shutil.chown(P["spool"], "ev2ahv", "ev2ahv")
        except (LookupError, PermissionError):
            pass
    if names and shutil.which("systemctl"):   # absent off-appliance (CI runners)
        sh("systemctl", "daemon-reload", check=False)
        sh("systemctl", "enable", "--now", "ev2ahv-upgrade.path", check=False)
    return names


def _status(**kw):
    """status.json in the spool, readable by the app (group ev2ahv)."""
    os.makedirs(P["spool"], exist_ok=True)
    f = os.path.join(P["spool"], "status.json")
    tmp = f + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(dict(kw, time=time.time()), fh)
    os.chmod(tmp, 0o640)
    try:
        shutil.chown(tmp, "root", "ev2ahv")
    except (LookupError, PermissionError):
        pass
    os.replace(tmp, f)


def apply_request(ops=None, apply_fn=None):
    """Apply the bundle the web UI uploaded. The spool is writable by the app, so nothing in it is trusted: the bundle
    is copied (never following links) into a root-only directory first, and apply() verifies it as usual."""
    apply_fn = apply_fn or apply
    req_f, bun_f = os.path.join(P["spool"], "request.json"), os.path.join(P["spool"], "bundle.tar.gz")
    if not os.path.exists(req_f):
        return None
    try:
        with open(req_f) as fh:
            req = json.load(fh)
    except ValueError:
        req = {}
    os.remove(req_f)                     # consume the request first, so the path unit does not fire again
    private = tempfile.mkdtemp(prefix="ev2ahv-upgrade-req-", dir=P["data"])
    try:
        local = os.path.join(private, "bundle.tar.gz")
        try:
            fd = os.open(bun_f, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        except OSError as e:
            _status(state="failed", message=f"no uploaded bundle: {e.strerror}", by=req.get("by"))
            return False
        with os.fdopen(fd, "rb") as src, open(local, "wb") as dst:
            shutil.copyfileobj(src, dst)
        os.remove(bun_f)
        _status(state="running", message="verifying and installing", by=req.get("by"), from_version=current_version())
        try:
            bdir = apply_fn(local, bool(req.get("force")), ops) if ops else apply_fn(local, bool(req.get("force")))
        except UpgradeError as e:
            _status(state="failed", message=str(e), by=req.get("by"), version=current_version())
            return False
        _status(state="done", message=f"upgraded; backup in {bdir}", by=req.get("by"), version=current_version())
        return True
    finally:
        rm_tree(private)


def busy():
    """True while a migration step runs (runner subprocesses of the app)."""
    out = sh("ps", "-eo", "args=", check=False).stdout
    return any("ev2ahv_server.runner" in line and "ps -eo" not in line for line in out.splitlines())


def fetch(path, cookie=None):
    """GET path over the app's unix socket; returns (HTTP status, body). Status 0 when curl got no answer."""
    cmd = ["curl", "-s", "-m", "30", "--unix-socket", P["sock"], "-w", "\n%{http_code}"]
    if cookie:
        cmd += ["-H", f"Cookie: ev2ahv_session={cookie}"]
    out = sh(*cmd, "http://app" + path, check=False).stdout
    body, _, code = out.rpartition("\n")
    return (int(code) if code.strip().isdigit() else 0), body


def data_check(want):
    """The app must be able to read what it stored: every list endpoint in HEALTH_PATHS has to answer 200.
    appinfo alone passed while /api/v2/plans was a 500 after a real upgrade (a plan stored by an older version)."""
    if vtuple(want) < HEALTH_DATA_FROM:
        log(f"{want} predates the stored-data health check; only appinfo was checked")
        return
    try:
        with open(P["cookie"]) as fh:
            cookie = fh.read().strip()
    except OSError as e:
        raise UpgradeError(f"the new version wrote no health session ({e})")
    for path in HEALTH_PATHS:
        code, body = fetch(path, cookie)
        if code != 200:
            raise UpgradeError(f"health check: GET {path} returned {code or 'no answer'} ({body.strip()[:120]!r})")


def health(want, timeout=60):
    """GET /api/v2/appinfo over the app's unix socket until it reports the wanted version, then read the stored
    data through the list endpoints (plans, environments, events, settings)."""
    deadline = time.time() + timeout
    last = ""
    while time.time() < deadline:
        last = fetch("/api/v2/appinfo")[1].strip()
        try:
            if json.loads(last).get("version") == want:
                data_check(want)
                return True
        except ValueError:
            pass
        time.sleep(2)
    raise UpgradeError(f"new version did not answer its health check (last reply: {last[:200]!r})")


def systemctl(action):
    sh("systemctl", action, SERVICE)


def apply(bundle, force=False, ops=None):
    ops = ops or {"systemctl": systemctl, "health": health, "busy": busy, "install_venv": install_venv}
    old = current_version()
    work = tempfile.mkdtemp(prefix="ev2ahv-upgrade-", dir=P["data"])
    try:
        man = unpack(bundle, work)
        new = man["version"]
        log(f"bundle {new} verified ({len(man['files'])} files); installed {old}")
        if vtuple(new) < vtuple(old) and not force:
            raise UpgradeError(f"{new} is older than the installed {old}; pass --force to downgrade")
        if vtuple(old) < vtuple(man.get("min_from", "0.0.0")):
            raise UpgradeError(f"{new} needs at least {man['min_from']} installed first")
        if ops["busy"]():
            raise UpgradeError("a migration step is running; wait for it or pause the plan, then try again")

        bdir = os.path.join(P["data"], "backups", time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + old)
        os.makedirs(bdir, mode=0o700)
        log(f"stopping {SERVICE}; backup in {bdir}")
        ops["systemctl"]("stop")
        if os.path.isdir(P["state"]):
            shutil.copytree(P["state"], os.path.join(bdir, "state"), symlinks=True)
        if os.path.exists(P["env"]):
            shutil.copy2(P["env"], os.path.join(bdir, "ev2ahv.env"))
        shutil.move(P["app"], os.path.join(bdir, "app"))
        venv_changed = man.get("requirements_sha256") != _req_sha(os.path.join(bdir, "app"))
        if venv_changed:
            shutil.copytree(P["venv"], os.path.join(bdir, "venv"), symlinks=True)
        with open(os.path.join(bdir, "backup.json"), "w") as fh:
            json.dump({"from": old, "to": new, "venv": venv_changed, "time": time.time()}, fh)
        try:
            shutil.copytree(os.path.join(work, "app"), P["app"], symlinks=True)
            if venv_changed:
                log("requirements changed: rebuilding the venv from the bundled wheels")
                ops["install_venv"](os.path.join(work, "wheels"), os.path.join(work, "app", "requirements.txt"))
            if os.path.exists(os.path.join(work, "ev2ahv-upgrade")):
                shutil.copy2(os.path.join(work, "ev2ahv-upgrade"), P["self"])
                link_self()
            install_units(work)
            sh("chown", "-R", "root:root", P["app"], check=False)
            if shutil.which("restorecon"):   # absent off-appliance (CI runners)
                sh("restorecon", "-R", P["app"], check=False)
            ops["systemctl"]("start")
            ops["health"](new)
        except Exception as e:
            log(f"upgrade failed ({e}); restoring {old}")
            _restore(bdir, ops)
            raise UpgradeError(f"upgrade to {new} failed and {old} was restored: {e}")
        log(f"upgraded {old} -> {new}")
        return bdir
    finally:
        rm_tree(work)


def link_self():
    """Link the tool into /usr/sbin so `sudo ev2ahv-upgrade ...` finds it (sudo's secure_path has no /usr/local/sbin).
    Never replaces an existing file."""
    try:
        if not os.path.lexists(P["link"]):
            os.symlink(P["self"], P["link"])
    except OSError as e:
        log(f"could not link {P['link']}: {e}")


def _req_sha(app_dir):
    f = os.path.join(app_dir, "requirements.txt")
    return sha256(f) if os.path.exists(f) else None


def install_venv(wheels, requirements):
    tmp = P["venv"] + ".new"
    rm_tree(tmp)
    sh("python3.12", "-m", "venv", tmp)
    sh(os.path.join(tmp, "bin", "pip"), "install", "-q", "--no-index", "--find-links", wheels, "-r", requirements)
    rm_tree(P["venv"])   # the new venv is complete at this point
    os.rename(tmp, P["venv"])
    # the venv's scripts point at the temporary path; rewrite them to the final one
    for n in os.listdir(os.path.join(P["venv"], "bin")):
        f = os.path.join(P["venv"], "bin", n)
        if os.path.isfile(f) and not os.path.islink(f):
            with open(f, "rb") as fh:
                b = fh.read()
            if tmp.encode() in b:
                with open(f, "wb") as fh:
                    fh.write(b.replace(tmp.encode(), P["venv"].encode()))


def _restore(bdir, ops):
    root = os.path.realpath(os.path.join(P["data"], "backups"))
    if not os.path.realpath(bdir).startswith(root + os.sep):
        raise UpgradeError(f"refusing to restore from {bdir}: not inside {root}")
    if not os.path.isdir(os.path.join(bdir, "app")):   # check before anything is stopped or deleted
        raise UpgradeError(f"backup {bdir} has no app directory; nothing was changed")
    ops["systemctl"]("stop")
    replace_tree(os.path.join(bdir, "app"), P["app"])
    if os.path.isdir(os.path.join(bdir, "venv")):
        replace_tree(os.path.join(bdir, "venv"), P["venv"])
    if os.path.isdir(os.path.join(bdir, "state")):
        replace_tree(os.path.join(bdir, "state"), P["state"])   # copytree keeps modes, not owners
        sh("chown", "-R", "ev2ahv:ev2ahv", P["state"], check=False)
    if os.path.exists(os.path.join(bdir, "ev2ahv.env")):
        shutil.copy2(os.path.join(bdir, "ev2ahv.env"), P["env"])
    ops["systemctl"]("start")


def backups():
    d = os.path.join(P["data"], "backups")
    return sorted(os.path.join(d, n) for n in os.listdir(d)) if os.path.isdir(d) else []


BACKUP_NAME = re.compile(r"^\d{8}T\d{6}Z-[0-9A-Za-z._-]+$")


def prune(keep, dry_run=False):
    """Delete all but the newest `keep` backups. Only real directories named like the ones apply creates
    (<UTC time>-<version>) and holding an app/ are touched; anything else in backups/ is left alone. Returns
    (kept, removed) as lists of paths."""
    if not isinstance(keep, int) or keep < 1:
        raise UpgradeError("--keep must be at least 1 (the newest backup is what rollback uses)")
    root = os.path.realpath(os.path.join(P["data"], "backups"))
    mine = [b for b in backups()
            if BACKUP_NAME.match(os.path.basename(b)) and os.path.isdir(b) and not os.path.islink(b)
            and os.path.isdir(os.path.join(b, "app")) and os.path.realpath(b).startswith(root + os.sep)]
    kept, gone = mine[-keep:], mine[:-keep]
    for b in gone:
        log(("would remove " if dry_run else "removing ") + b)
        if not dry_run:
            rm_tree(b)
    return kept, gone


def rollback(ops=None):
    ops = ops or {"systemctl": systemctl}
    b = backups()
    if not b:
        raise UpgradeError("no backup to roll back to")
    log(f"restoring {b[-1]}")
    _restore(b[-1], ops)
    return b[-1]


def main(argv=None):
    ap = argparse.ArgumentParser(description="ev2ahv appliance upgrade")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("apply")
    a.add_argument("bundle")
    a.add_argument("--force", action="store_true", help="allow a downgrade")
    sub.add_parser("rollback")
    pr = sub.add_parser("prune")
    pr.add_argument("--keep", type=int, required=True, help="number of newest backups to keep (>= 1)")
    pr.add_argument("--dry-run", action="store_true")
    sub.add_parser("status")
    sub.add_parser("apply-request")
    args = ap.parse_args(argv)
    if os.geteuid() != 0:
        sys.exit("run as root (sudo)")
    try:
        if args.cmd == "apply":
            apply(args.bundle, args.force)
        elif args.cmd == "rollback":
            rollback()
        elif args.cmd == "apply-request":
            r = apply_request()
            print("no request" if r is None else "applied" if r else "failed (see status.json)")
        elif args.cmd == "prune":
            kept, gone = prune(args.keep, args.dry_run)
            print(f"kept {len(kept)}, {'would remove' if args.dry_run else 'removed'} {len(gone)}")
        else:
            print(f"installed {current_version()}")
            for b in backups():
                print("backup", b)
    except UpgradeError as e:
        sys.exit(f"ev2ahv-upgrade: {e}")


if __name__ == "__main__":
    main()
